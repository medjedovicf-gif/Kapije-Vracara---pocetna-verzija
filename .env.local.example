# Kopiraj ovaj fajl u .env.local i popuni sa svojim Supabase podacima
# (Supabase Dashboard -> Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-public-kljuc

# Ovaj kljuc NIKAD ne izlazi na frontend / u git.
# Koristi se samo u Edge Function-u za resetovanje lozinki (server-side).
SUPABASE_SERVICE_ROLE_KEY=tvoj-service-role-kljuc

# Browser push (generiši sa: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@kapijevracara.rs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tvoj-vapid-public-kljuc
VAPID_PRIVATE_KEY=tvoj-vapid-private-kljuc

# Transitland proxy za GSP/GTFS Beograd
TRANSITLAND_API_KEY=tvoj-transitland-api-kljuc
